{
  "functions": {
    "api/index.js": {
      "includeFiles": "index.html"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index" }
  ],
  "headers": [
    {
      "source": "/menu-video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/restaurants/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
