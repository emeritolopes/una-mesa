{
  "functions": {
    "api/index.js": {
      "includeFiles": "*.html"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
