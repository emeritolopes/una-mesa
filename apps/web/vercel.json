{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "unamesa.co" }],
      "destination": "/index-madrid.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.unamesa.co" }],
      "destination": "/index-madrid.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
