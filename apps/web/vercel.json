{
  "redirects": [
    {
      "source": "/((?!portfolio).+)",
      "has": [{ "type": "host", "value": "unamesa.co.uk" }],
      "destination": "https://app.unamesa.co.uk/$1",
      "permanent": false
    },
    {
      "source": "/((?!portfolio).+)",
      "has": [{ "type": "host", "value": "www.unamesa.co.uk" }],
      "destination": "https://app.unamesa.co.uk/$1",
      "permanent": false
    },
    {
      "source": "/((?!portfolio).*)",
      "has": [{ "type": "host", "value": "unamesa.co" }],
      "destination": "https://app.unamesa.co/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "unamesa.co.uk" }],
      "destination": "/index-uk.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.unamesa.co.uk" }],
      "destination": "/index-uk.html"
    }
  ]
}
